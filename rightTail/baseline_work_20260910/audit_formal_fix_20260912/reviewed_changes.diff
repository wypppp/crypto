+#: 子运行退出码的处置（审查 v1.19-formal P1-2：原先对所有非零退出一律重启）。
+#: 1 = 判定失败（含传输错误导致的 data_missing）：检查点保住已完成候选，续跑只重测未完成的 ⇒ 可自动续跑。
+#: 2 = 前置条件不成立：只有 endpoint_unreachable（端点瞬时不可达）值得自动重试；
+#:     chain_id_mismatch / pinned_snapshot_mismatch / finalized_reorg / hard_limit_install_failed /
+#:     spec_missing 等是配置或环境问题，重试只会重复失败 ⇒ 人工处置。
+#: 3 = 有序停机（资源 / 墙钟 / 信号 / 预算耗尽）：**不自动重启** —— 每次重启都重新获得一份
+#:     max_calls / max_seconds 预算，会把资源与配额问题掩盖成"多跑几次就好了" ⇒ 人工处置。
+RETRY_EXIT_2_REASONS = {"endpoint_unreachable"}
+
+
+def abort_reasons(ev_path):
+    """该证据文件里的 abort 原因（末尾半行忽略）。"""
+    out = []
+    p_ = Path(ev_path)
+    if not p_.is_file():
+        return out
+    for line in p_.read_text(encoding="utf-8", errors="replace").splitlines():
+        if '"abort"' not in line:
+            continue
+        try:
+            r = json.loads(line)
+        except ValueError:
+            continue                      # 半行/坏行：不当作原因，也不让它中断判定
+        if r.get("kind") == "abort":
+            out.append(r.get("reason"))
+    return out
+
+
+def retry_decision(rc, ev_path):
+    """(是否自动续跑, 理由)。理由写进清单，便于事后复核为什么重试/为什么不重试。"""
+    if rc == 0:
+        return False, "ok"
+    if rc == 1:
+        return True, "judged_failure: resume re-measures only unfinished candidates"
+    if rc == 2:
+        rs = abort_reasons(ev_path)
+        if rs and all(x in RETRY_EXIT_2_REASONS for x in rs):
+            return True, f"precondition:{rs} is transient"
+        return False, f"precondition:{rs or 'unknown'} needs human action"
+    if rc == 3:
+        return False, "orderly_stop: resource/budget/signal - restarting would renew the budget"
+    return False, f"exit_{rc}: unexpected"
+
+
+def spent(run_dir):
+    """本运行目录**已经发生**的成本：枚举目录下所有证据文件（含中断、只有前缀的），
+    不依赖清单里是否已有完成条目 —— 未收尾的子进程同样消耗了配额（审查 v1.19-formal P1-3）。
+
+    返回 {rpc, etherscan, unfinished_rpc_begin, wall_s, evidence_files, incomplete_files}。
+    """
+    d = Path(run_dir)
+    rpc = eth = begins = ends = 0
+    files, incomplete = [], []
+    for f in sorted(d.glob("*.evidence.jsonl")):
+        n_footer = 0
+        for line in f.read_text(encoding="utf-8", errors="replace").splitlines():
+            try:
+                r = json.loads(line)
+            except ValueError:
+                continue                  # 尾部半行：跳过该行，不让整份账目报错或归零
+            k = r.get("kind")
+            if k == "rpc":
+                rpc += 1
+            elif k == "etherscan":
+                eth += 1
+            elif k == "rpc_begin":
+                begins += 1
+            elif k == "rpc_end":
+                ends += 1
+            elif k == "run_footer":
+                n_footer += 1
+        files.append(f.name)
+        if n_footer == 0:
+            incomplete.append(f.name)
+    rows = _read_manifest(d / "runs.jsonl")
+    wall = round(sum(r.get("wall_s") or 0 for r in rows if r.get("kind") == "run"), 1)
+    return {"rpc": rpc, "etherscan": eth, "unmatched_rpc_begin": max(begins - ends, 0),
+            "wall_s": wall, "evidence_files": files, "incomplete_evidence": incomplete}
+
