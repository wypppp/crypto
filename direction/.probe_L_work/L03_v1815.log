    "fallback": "originally set at\\s+(?P<old>\\d{4}-\\d{2}-\\d{2}\\s*\\d{1,2}:\\d{2}\\s*(?:AM|PM)?\\s*\\(?\\s*UTC\\s*\\)?).{0,80}?will be\\s+(?P<action2>advanced|brought forward|postponed|rescheduled|delayed)\\s+to\\s+(?P<new>\\d{4}-\\d{2}-\\d{2}\\s*\\d{1,2}:\\d{2}\\s*(?:AM|PM)?\\s*\\(?\\s*UTC\\s*\\)?)",
    "time_parse": "old / new 捕获的是**完整时间字符串**,须各自再用 rules.TIME(含命名组)解析;**禁止把 TIME 展开进本模板**",
    "link_rule": "按 (baseAsset, old_time) 匹配既有事件;成功则更新 T_scheduled 为 new_time 并追加 time_versions[];失败标 AMBIGUOUS",
    "verified_example": "SUI 160121:old=2023-05-03 12:15 UTC → new=2023-05-03 12:00 UTC(action=advanced)"
