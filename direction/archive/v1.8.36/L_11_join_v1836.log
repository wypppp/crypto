   "UPDATE_ADVANCED": {
    "detect": "(?P<action>advanced|brought forward|postponed|rescheduled|delayed)",
    "extract": "(?:listing|trading start)\\s*(?:start\\s*)?time\\s+for\\s+(?P<name>[^()\\n]{1,60}?)\\s*\\((?P<sym>[A-Za-z0-9]{1,15})\\)\\s*,?\\s*originally set at\\s+(?P<old>\\d{4}-\\d{2}-\\d{2}\\s*\\d{1,2}:\\d{2}\\s*(?:AM|PM)?\\s*\\(?\\s*UTC\\s*\\)?)\\s*,?\\s*will be\\s+(?P<action2>advanced|brought forward|postponed|rescheduled|delayed)\\s+to\\s+(?P<new>\\d{4}-\\d{2}-\\d{2}\\s*\\d{1,2}:\\d{2}\\s*(?:AM|PM)?\\s*\\(?\\s*UTC\\s*\\)?)",
    "fallback": "originally set at\\s+(?P<old>\\d{4}-\\d{2}-\\d{2}\\s*\\d{1,2}:\\d{2}\\s*(?:AM|PM)?\\s*\\(?\\s*UTC\\s*\\)?).{0,80}?will be\\s+(?P<action2>advanced|brought forward|postponed|rescheduled|delayed)\\s+to\\s+(?P<new>\\d{4}-\\d{2}-\\d{2}\\s*\\d{1,2}:\\d{2}\\s*(?:AM|PM)?\\s*\\(?\\s*UTC\\s*\\)?)",
    "time_parse": "old / new 捕获的是**完整时间字符串**,须各自再用 rules.TIME(含命名组)解析;**禁止把 TIME 展开进本模板**",
    "link_rule": "按 (baseAsset, old_time) 匹配既有事件;成功则更新 T_scheduled 为 new_time 并追加 time_versions[];失败标 AMBIGUOUS",
    "verified_example": "SUI 160121:old=2023-05-03 12:15 UTC → new=2023-05-03 12:00 UTC(action=advanced)",
    "asset_scope": {
     "clause": "(?:listing|trading start)\\s*(?:start\\s*)?time\\s+for\\s+(?P<who>.{1,120}?)\\s*,?\\s*originally set at",
     "rule": "fallback 分支无 sym 组时,在『time for … originally set at』之间的**有界子句**内用已冻结的 rules.ASSET_PAREN 提取资产代号 —— 复用既有规则,不新写正则,不做无界搜索。",
     "why": "实测 2 篇走 fallback:160544 是 `FLOKI (FLOKI) and Pepe (PEPE)` **双资产**(extract 模板只容一个 sym);269535 是 `(UTC).` 多出句点卡住 `\\s*,?\\s*will be`。两篇均经原文核验,资产与新旧时间明确。",
     "measured": "全语料 UPDATE_ADVANCED 命中 9 篇:7 篇 EXTRACT、2 篇 FALLBACK;10 个 (base, old) 键中 8 个可链接。",
     "decided_by_implementer": "这不改变公告的语义分类,只确定已判定为时间更新的公告指向哪个资产;若认为应改判 AMBIGUOUS,可推翻。"
    }
   },
   "TIME_NOGROUP": "\\d{4}-\\d{2}-\\d{2}\\s*\\d{1,2}:\\d{2}\\s*(?:AM|PM)?\\s*\\(?\\s*UTC\\s*\\)?",
   "NORMALIZE": {
    "entities": "&nbsp;|&#160;| ",
    "collapse_ws": "\\s+",
    "amp": "&amp;"
   },
   "OPERATION_CLAUSE": {
    "_note": "PAIR 只允许在此句内运行;**禁止对全文调用 PAIR.finditer**",
    "B": "will open trading for(?P<clause>[^.]{0,400}?)(?:trading pairs?|pair)\\s+at\\s+[^.]{0,60}?UTC\\s*\\)?",
    "A": "will list(?P<clause>[^.]{0,400})",
    "generic": "(?:will list|will then list|open trading (?:for|with|against))(?P<clause>[^.]{0,400})"
   },
   "PAIR_EXCLUDE": {
    "_note": "黑名单只对**未归档**候选生效。实测 16 词中 ME/T 是真实 baseAsset,无条件排除会误杀 article 219677(Magic Eden)。其余 14 词均非真实 baseAsset。",
