   "A_LISTING_HEAD": "will list\\s+(?P<asset_segment>.{1,200}?)\\s+and\\s+(?:tentatively\\s+)?(?:set\\s+to\\s+)?(?:will\\s+)?open trading\\s+for\\s+(?P<tail>.{0,220}?)\\s*at\\s+(?P<time>\\d{4}-\\d{2}-\\d{2}[^)]{0,30}?UTC\\s*\\)?)",
   "PAIR_BLOCK": {
    "_note": "正文几乎无换行(1453 篇仅 9 篇),不得用 [^\\n];必须用**显式终止锚点**",
    "start": "New Spot Trading Pairs?\\s*:?\\s*",
    "terminators": [
