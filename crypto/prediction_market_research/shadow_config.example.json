{
  "output_dir": "crypto/prediction_market_research/data/shadow",
  "symbols": ["BTC", "ETH", "SOL"],
  "intervals_minutes": [5, 15],
  "clob_ws_url": "wss://ws-subscriptions-clob.polymarket.com/ws/market",
  "rtds_ws_url": "wss://ws-live-data.polymarket.com",
  "coinbase_ws_url": "wss://ws-feed.exchange.coinbase.com",
  "kraken_ws_url": "wss://ws.kraken.com/v2",
  "binance_ws_url": "wss://stream.binance.com:9443/ws",
  "poll_seconds": 2.0,
  "discovery_seconds": 60.0,
  "clock_poll_seconds": 60.0,
  "resolution_poll_seconds": 30.0,
  "request_timeout_seconds": 8.0,
  "max_markets": 24,
  "past_markets_per_series": 1,
  "future_markets_per_series": 1,
  "max_workers": 12,
  "discovery_pages": 2,
  "discovery_page_size": 100,
  "fsync_every": 5000,
  "writer_queue_max_events": 100000,
  "gzip_compresslevel": 1,
