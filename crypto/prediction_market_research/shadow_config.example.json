  "rtds_heartbeat_seconds": 5.0,
  "spot_heartbeat_seconds": 20.0,
  "reconnect_max_seconds": 30.0,
  "market_end_grace_seconds": 120.0,
  "resolution_start_grace_seconds": 5.0,
  "rtds_topics": [
    "crypto_prices_chainlink",
    "crypto_prices_twap_thirty",
    "crypto_prices_twap_sixty"
  ],
  "enable_coinbase_ws": true,
  "enable_kraken_ws": true,
  "enable_binance_ws": false
}
