+#: 这些 RpcFailure 表示**链没有给出可比的答案** —— 连接/HTTP/协议层坏了，或节点返回空。
+INTERFACE_RPC_KINDS = {"transport", "http", "protocol", "response_limit", "missing_result"}
+
+
+def interface_failure(e):
+    """是不是"没拿到答案"（接口故障），而不是"拿到了答案但不符"。
+
+    区分原则只有一条：**链有没有给出可比的答案**。
+    * 传输 / HTTP / 协议 / 超限 / 空结果 → 没有答案 ⇒ `unavailable`；
+    * `rpc` 类（节点返回 JSON-RPC 错误对象）要再分：合约**回滚**是链给出的确定答案，
+      属于证据；其余（限流、`header not found` 等）是节点侧故障 ⇒ `unavailable`。
+      若把回滚也当 unavailable，一个确定会回滚的调用会让续跑无限重试。
+    * `budget` / `forbidden_method` / `abi` 等不是接口故障，保持各自原因，交上层处理。
+    """
+    if not isinstance(e, V.RpcFailure):
+        return False
+    kind = getattr(e, "kind", None)
+    if kind in INTERFACE_RPC_KINDS:
+        return True
+    return kind == "rpc" and "revert" not in str(e).lower()
+
+
+#: 恢复核验未完成时，这些状态**保留自己更具体的原因**，不被改写成 data_missing。
+#: 其余状态（包括已到达的 measured_exit 等）则失去测量结论 ⇒ data_missing（审查 E）。
+_KEEP_OWN_REASON = {"aborted_by_shutdown", "budget_exhausted", "decode_error",
+                    "state_validation_failed", "data_missing"}
+
+
+def _unavailable_item(step, e):
+    return {"step": step, "error_kind": getattr(e, "kind", type(e).__name__),
+            "detail": str(e)[:160]}
+
+
+def fold_validation(v):
+    """把一次校验的结果折叠成四态之一，并同步 `passed`。
+
+    * `failed` —— 有完整可比证据且确实不符（`failures` 非空）。
+      与后来的接口故障**并存时两者都保留**，状态仍是 failed；
+    * `unavailable` —— 开始了但没做完（`unavailable` 非空），`passed=None`，**不是 True**；
+    * `passed` —— 做完且没有不符。
+    未开始的校验不产生记录，由调用方视为 `not_applicable`。
+    """
+    if v.get("failures"):
+        v["status"], v["passed"] = "failed", False
+    elif v.get("unavailable"):
+        v["status"], v["passed"] = "unavailable", None
+    else:
+        v["status"], v["passed"] = "passed", True
+    return v
+
+
+def validation_placeholder(stage):
+    """校验**开始前**先放一个"未完成"占位。
+
+    旧版在校验函数返回后才写 `rec[...]`；函数中途抛出时记录缺席，
+    而缺席被当成"不适用 ⇒ 通过"，于是出现"没做完却 validation_passed=true"
+    （审查 v1.16：入场取代码遇到传输错误 ⇒ data_missing + validation_passed=true）。
+    """
+    return {"status": "unavailable", "passed": None, "failures": [],
+            "unavailable": [{"step": stage, "error_kind": "not_completed",
+                             "detail": "validation started but did not complete"}]}
+
+
